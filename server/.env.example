PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/credit-ledger
# Login token ko sign karne ki secret key. Lambi random string rakhein (kisi ko na batayein).
# Generate karne ke liye: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Production mein frontend ka URL (comma se alag karke multiple)
CORS_ORIGIN=http://localhost:5173
